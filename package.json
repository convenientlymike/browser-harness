{
  "name": "browser-harness",
  "version": "1.0.0",
  "description": "CDP-driven browser event capture and runtime-failure analysis CLI",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "harness": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "test": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && node --import tsx/esm --test tests/summary.test.ts",
    "test:run": "node --test tests/summary.test.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "playwright",
    "cdp",
    "browser",
    "debugging",
    "cli",
    "runtime-errors",
    "devtools"
  ],
  "author": "Michael (@convenientlymike)",
  "license": "MIT"
}
